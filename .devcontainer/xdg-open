#!/bin/sh
# The container has no desktop, so there is no real xdg-open, and `cydeo login` would crash
# (spawn xdg-open ENOENT) before it can wait for approval. In the VS Code terminal, $BROWSER
# opens the link in your own browser; anywhere else this does nothing and the CLI prints the link.
if [ -n "${BROWSER:-}" ]; then exec "$BROWSER" "$@"; fi
exit 0
